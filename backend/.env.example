SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Only for projects on the legacy HS256 JWT secret; leave empty for JWKS (asymmetric keys)
SUPABASE_JWT_SECRET=

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
VOYAGE_API_KEY=

# Comma-separated list of allowed browser origins
FRONTEND_ORIGIN=http://localhost:5173

# Models (deepseek-flash: fast/cheap, deepseek-v4-pro: strongest)
QUERY_MODEL=deepseek-flash
ANSWER_MODEL=deepseek-v4-pro
EVALUATOR_MODEL=deepseek-flash
# Thinking effort per agent: empty disables thinking, else low | high | max
QUERY_EFFORT=
ANSWER_EFFORT=low
EVALUATOR_EFFORT=low

# Pages processed per ingestion request (keep each request under Vercel's maxDuration)
INGEST_BATCH_PAGES=25
