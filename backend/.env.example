# Local storage: SQLite database (data/app.db), uploaded PDFs (data/files/) and the ChromaDB vector index (data/chroma/)
DATA_DIR=data
# Signs login tokens and PDF links. Leave empty to auto-generate one into DATA_DIR/.secret
APP_SECRET=
TOKEN_TTL_HOURS=12

# Demo accounts, created on first start when the database has no users.
# Change these before showing the app to anyone; delete DATA_DIR to re-seed.
# The officer can search the Department of Health and Wellbeing and Department of Digital Services collections.
DEMO_ADMIN_EMAIL=admin@agency.example
DEMO_ADMIN_PASSWORD=admin-demo-2026
DEMO_USER_EMAIL=officer@agency.example
DEMO_USER_PASSWORD=officer-demo-2026

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Comma-separated list of allowed browser origins
FRONTEND_ORIGIN=http://localhost:5173

# Models (deepseek-flash: fast/cheap, deepseek-v4-pro: strongest)
QUERY_MODEL=deepseek-flash
ANSWER_MODEL=deepseek-v4-pro
EVALUATOR_MODEL=deepseek-flash
# Thinking effort per agent: empty disables thinking, else low | high | max
QUERY_EFFORT=
ANSWER_EFFORT=low
EVALUATOR_EFFORT=low

# Embeddings run locally and are stored in ChromaDB (DATA_DIR/chroma).
# chroma: Chroma's built-in all-MiniLM-L6-v2, downloaded once (~80 MB) on first use.
# hash: fully offline keyword-style fallback. Changing the provider requires re-indexing every document.
EMBEDDING_PROVIDER=chroma
EMBEDDING_DIM=384

# Pages processed per ingestion request (drives the progress bar in the admin UI)
INGEST_BATCH_PAGES=25
