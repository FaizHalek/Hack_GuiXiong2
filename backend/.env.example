# Local storage: SQLite database (data/app.db) and uploaded PDFs (data/files/)
DATA_DIR=data
# Signs login tokens and PDF links. Leave empty to auto-generate one into DATA_DIR/.secret
APP_SECRET=
TOKEN_TTL_HOURS=12

# Demo accounts, created on first start when the database has no users.
# Change these before showing the app to anyone; delete DATA_DIR/app.db to re-seed.
DEMO_ADMIN_EMAIL=admin@agency.example
DEMO_ADMIN_PASSWORD=admin-demo-2026
DEMO_USER_EMAIL=officer@agency.example
DEMO_USER_PASSWORD=officer-demo-2026

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Comma-separated list of allowed browser origins
FRONTEND_ORIGIN=http://localhost:5173

# Models (deepseek-flash: fast/cheap, deepseek-v4-pro: strongest)
QUERY_MODEL=deepseek-flash
ANSWER_MODEL=deepseek-v4-pro
EVALUATOR_MODEL=deepseek-flash
# Thinking effort per agent: empty disables thinking, else low | high | max
QUERY_EFFORT=
ANSWER_EFFORT=low
EVALUATOR_EFFORT=low

# Embeddings run locally. fastembed downloads the model once (~70 MB) on first use.
# Use EMBEDDING_PROVIDER=hash for a fully offline keyword-style fallback.
# Changing provider/model requires re-indexing every document.
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# Pages processed per ingestion request (drives the progress bar in the admin UI)
INGEST_BATCH_PAGES=25
